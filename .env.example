# Copy to .env (git-ignored) and fill in. Real environment variables override this file.
# Alpaca keys: https://app.alpaca.markets -> API keys (paper trading keys work for market data).
APCA_API_KEY_ID=your-alpaca-key-id
APCA_API_SECRET_KEY=your-alpaca-secret-key
# iex (default, free real-time, one exchange) or sip (all exchanges; 15 min delayed on the free plan)
ALPACA_DATA_FEED=iex
# Requests per minute LinkCharts allows itself (free plan limit is 200)
# ALPACA_RATE_LIMIT=190
